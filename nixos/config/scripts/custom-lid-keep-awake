#!/bin/bash
set -euo pipefail

unit=custom-lid-keep-awake.service
clamshell_unit=custom-clamshell.service
# The inhibited child loses NOTIFY_SOCKET; pass it explicitly for readiness.
# This service-only action must run before taking the transition lock.
if [[ ${1:-} == hold || ${1:-} == hold-clamshell ]]; then
    what=handle-lid-switch:sleep
    who='Lid Keep-Awake'
    if [[ $1 == hold-clamshell ]]; then
        what=handle-lid-switch
        who='Clamshell'
    fi
    exec systemd-inhibit \
        --what="$what" --mode=block \
        --who="$who" --why='Keep background work running with the lid closed' \
        "$(command -v bash)" -c 'NOTIFY_SOCKET="$1" "$2" --ready && exec "$3" infinity' \
        bash "${NOTIFY_SOCKET:?}" "$(command -v systemd-notify)" "$(command -v sleep)"
fi

# Serialize menu actions, lid events, and idle callbacks.
exec 9>"${XDG_RUNTIME_DIR:?}/custom-lid-keep-awake.lock"
flock -x 9

active() {
    systemctl --user is-active --quiet "${1:-$unit}"
}

lid_closed() {
    grep -qsE 'state:[[:space:]]+closed' /proc/acpi/button/lid/*/state
}

disable() {
    local target
    local targets=("$clamshell_unit" "$unit")
    if (( $# )); then targets=("$1"); fi
    for target in "${targets[@]}"; do
        if active "$target"; then
            systemctl --user stop "$target"
        fi
    done
}

lock_and_blank() {
    # Hyprlock runs in the background; it must not inherit our flock.
    custom-lock-screen 9>&-
    hyprctl dispatch dpms off
}

start_inhibitor() {
    local target=$1 action=$2 title=$3
    active "$target" && return 0
    # Readiness is sent only after systemd-inhibit holds the actual locks.
    if ! systemd-run --user --quiet --collect --unit="$target" \
        --property=Type=notify --property=NotifyAccess=all \
        --property=PartOf=graphical-session.target \
        --property=TimeoutStartSec=10s --property=TimeoutStopSec=5s \
        "$(command -v bash)" "$(readlink -f "$0")" "$action"; then
        echo "$title failed: could not prevent lid-triggered sleep." >&2
        busctl --user call org.freedesktop.Notifications /org/freedesktop/Notifications \
            org.freedesktop.Notifications Notify susssasa{sv}i \
            "$title" 0 '' "$title failed" \
            'Could not prevent lid-triggered sleep.' 0 0 -1 >/dev/null || true
        return 1
    fi
}

enable() {
    active && return 0
    start_inhibitor "$unit" hold 'Lid Keep-Awake'
    if lid_closed; then
        lock_and_blank
    fi
}

case "${1:-}" in
    enable) enable ;;
    disable) disable ;;
    toggle)
        if active; then disable "$unit"; else enable; fi
        ;;
    status) active ;;
    close)
        # A queued close event must not re-arm the hold after lid reopening.
        lid_closed || exit 0
        if active; then
            lock_and_blank
        else
            if ! active "$clamshell_unit"; then
                monitors=$(hyprctl -j monitors all)
                external=$(jq -r 'if type != "array" then error("invalid monitor list") else
                    any(.[]; .disabled != true and (.name | test("^(DP|HDMI|DVI|VGA)-"))) end' <<<"$monitors")
                if [[ $external == true ]]; then
                    start_inhibitor "$clamshell_unit" hold-clamshell 'Clamshell'
                fi
            fi
            hyprctl keyword monitor 'eDP-1,disable'
        fi
        ;;
    open)
        # Restore displays before releasing the lid inhibitor.
        result=0
        hyprctl reload || result=$?
        hyprctl dispatch dpms on || result=$?
        disable
        exit "$result"
        ;;
    resume-display)
        if active && lid_closed; then
            exit 0
        fi
        hyprctl dispatch dpms on
        brightnessctl -r
        ;;
    *)
        echo 'Usage: custom-lid-keep-awake {enable|disable|toggle|status|close|open|resume-display}' >&2
        exit 2
        ;;
esac
